---
// A full-width image with a dark fade at the top and bottom, the top bar over it,
// and the page's own heading (the slot) at the bottom — the WordPress "cover" block.
import type { ImageMetadata } from 'astro';
import TopBar from './TopBar.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  position: string;
  minHeight?: string;
}

const { image, alt, position, minHeight } = Astro.props;
---

<header class="cover" style={minHeight ? `min-height: ${minHeight}` : undefined}>
  <img
    class="cover-image"
    src={image.src}
    width={image.width}
    height={image.height}
    alt={alt}
    style={`object-position: ${position}`}
  />
  <span class="cover-fade" aria-hidden="true"></span>
  <div class="cover-inner">
    <TopBar />
    <div class="cover-heading">
      <slot />
    </div>
  </div>
</header>
